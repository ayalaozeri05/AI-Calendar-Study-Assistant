# AI Calendar Study Assistant — environment template
# Copy to .env and fill in values. Never commit real secrets.

# Backend server
API_HOST=127.0.0.1
API_PORT=8000

# Supabase (required for demo user + activity log)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Telegram (required to send study briefs)
TELEGRAM_BOT_TOKEN=
DEMO_TELEGRAM_CHAT_ID=

# Google Calendar OAuth (Desktop client JSON path + per-user token dir)
# Download OAuth client credentials from Google Cloud Console (Desktop app type).
GOOGLE_CALENDAR_CREDENTIALS_PATH=secrets/google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_DIR=local_tokens/google_calendar
GOOGLE_CALENDAR_ID=primary

# Ollama in Docker (optional wording polish / future RAG — keep installed)
# Start: docker compose up -d
# Pull model once: docker exec -it ai-study-planner-ollama ollama pull llama3.2
# Backend on the host uses localhost (not the Docker service hostname).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SEC=75
# Stable demo (default): deterministic scheduling only — no Ollama wait.
# Set true only for explicit Ollama polish verification.
AI_POLISH_ENABLED=false
# Deprecated diagnostic override. Prefer AI_POLISH_ENABLED=false.
SKIP_OLLAMA_POLISH=false

# RAG (PDF study materials → Chroma → Ollama answers)
CHROMA_PERSIST_DIR=backend/chroma
RAG_UPLOAD_DIR=backend/uploads/rag
