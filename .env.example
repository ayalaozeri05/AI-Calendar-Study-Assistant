# AI Calendar Study Assistant — environment template
# Copy to .env and fill in values. Never commit real secrets.

# Backend server
API_HOST=127.0.0.1
API_PORT=8000

# Supabase (required for demo user + activity log)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Telegram (required to send study briefs)
TELEGRAM_BOT_TOKEN=
DEMO_TELEGRAM_CHAT_ID=

# Google Calendar (optional — demo events used when credentials file is missing)
GOOGLE_CALENDAR_CREDENTIALS_FILE=
GOOGLE_CALENDAR_ID=primary

# Ollama (optional — not wired in MVP; for later AI phase)
OLLAMA_BASE_URL=
